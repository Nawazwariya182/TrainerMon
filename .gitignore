# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
MODELS/
graphify-out/
backend/chroma_db/
backend/__pycache__/
__pycache__/
*.pyc


# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# workspaces
workspace_projects/*/.git/
workspace_projects/*/data/raw/
workspace_projects/*/checkpoints/

# typescript
*.tsbuildinfo
next-env.d.ts
